{{ 'section-ecom-guide-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shop_link = section.settings.shop_link | strip
  if shop_link == blank or shop_link contains 'javascript:'
    assign shop_link = '#ecom-guide-grid'
  endif
  assign animation = section.settings.button_animation
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .gg-banner {
    --gg-bg: var(--gradient-background);
    --gg-text: rgb(var(--color-foreground));
    --gg-strip-bg: {{ section.settings.strip_background }};
    --gg-strip-text: {{ section.settings.strip_color }};
    --gg-heading-size: {{ section.settings.heading_size }}px;
    --gg-body-size: {{ section.settings.body_size }}px;
    --gg-shop-size: {{ section.settings.shop_size }}px;
    --gg-strip-size: {{ section.settings.strip_size }}px;
    --gg-gutter: {{ section.settings.gutter }}px;
    --gg-content-width: {{ section.settings.content_width }}px;
    --gg-place-y: {{ section.settings.content_place_y }}%;
    --gg-nudge-x: {{ section.settings.content_nudge_x }}px;
    --gg-nudge-y: {{ section.settings.content_nudge_y }}px;
    --gg-m-pad-x: {{ section.settings.mobile_gutter }}px;
    --gg-m-space: {{ section.settings.mobile_space_below }}px;
    --gg-m-heading: {{ section.settings.mobile_heading_size }}px;
    --gg-m-body: {{ section.settings.mobile_body_size }}px;
    --gg-m-btn-bottom: {{ section.settings.mobile_button_bottom }}px;
  }

  #shopify-section-{{ section.id }} .gg-btn--shop {
    --gg-btn-bg: {{ section.settings.shop_background }};
    --gg-btn-text: {{ section.settings.shop_text }};
    --gg-btn-hover-bg: {{ section.settings.shop_hover_background }};
    --gg-btn-hover-text: {{ section.settings.shop_hover_text }};
  }
{%- endstyle -%}

<section
  class="gg-banner gg-banner--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} gradient gg-banner--ratio-{{ section.settings.image_ratio }} gg-banner--x-{{ section.settings.content_place_x }} gg-banner--align-{{ section.settings.content_alignment }} gg-banner--m-align-{{ section.settings.mobile_alignment }} gg-banner--m-btn-{{ section.settings.mobile_button_place }}{% if section.settings.description_mobile != blank %} gg-banner--mobile-copy{% endif %}{% if section.settings.enable_entrance %} gg-banner--enter{% endif %}"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="gg-banner__hero">
    {%- liquid
      assign desktop_image = section.settings.illustration
      assign mobile_image = section.settings.illustration_mobile
    -%}
    <div class="gg-banner__art{% if desktop_image == blank %} is-placeholder{% endif %}{% if mobile_image == blank %} is-placeholder-mobile{% endif %}" aria-hidden="true">
      {%- if desktop_image != blank -%}
        <img
          class="gg-art-desktop"
          src="{{ desktop_image | image_url: width: 2000 }}"
          srcset="{{ desktop_image | image_url: width: 800 }} 800w, {{ desktop_image | image_url: width: 1400 }} 1400w, {{ desktop_image | image_url: width: 2000 }} 2000w"
          sizes="100vw"
          alt=""
          width="{{ desktop_image.width }}"
          height="{{ desktop_image.height }}"
          fetchpriority="high"
        >
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg gg-art-desktop' }}
      {%- endif -%}
      {%- if mobile_image != blank -%}
        <img
          class="gg-art-mobile"
          src="{{ mobile_image | image_url: width: 1200 }}"
          srcset="{{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 900 }} 900w, {{ mobile_image | image_url: width: 1200 }} 1200w"
          sizes="100vw"
          alt=""
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
        >
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg gg-art-mobile' }}
      {%- endif -%}
    </div>
    <div class="gg-banner__scrim" aria-hidden="true"></div>
    <div class="gg-banner__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="gg-banner__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="gg-banner__description gg-banner__description--desktop">{{ section.settings.description | escape | newline_to_br }}</div>
      {%- endif -%}
      {%- if section.settings.description_mobile != blank -%}
        <div class="gg-banner__description gg-banner__description--mobile">{{ section.settings.description_mobile | escape | newline_to_br }}</div>
      {%- endif -%}
      {%- if section.settings.shop_label != blank -%}
        <a
          class="gg-btn gg-btn--shop{% if animation != 'none' %} gg-btn--{{ animation }}{% endif %}"
          href="{{ shop_link }}"
          {% if shop_link contains '#' %}data-gg-scroll{% endif %}
        >
          <span class="gg-btn__label">{{ section.settings.shop_label | escape }}</span>
          {% render 'ecom-guide-arrow' %}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.strip_text != blank -%}
    <div class="gg-banner__strip{% if section.settings.strip_marquee %} gg-banner__strip--marquee{% endif %}">
      <div class="gg-banner__strip-track">
        <p class="gg-banner__strip-text">{{ section.settings.strip_text | escape }}</p>
        {%- if section.settings.strip_marquee -%}
          <p class="gg-banner__strip-text" aria-hidden="true">{{ section.settings.strip_text | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    document.querySelectorAll('[data-gg-scroll]').forEach(function (link) {
      if (link.dataset.ggBound === 'true') return;
      link.dataset.ggBound = 'true';
      link.addEventListener('click', function (event) {
        var id = (link.getAttribute('href') || '').split('#')[1];
        var target = id && document.getElementById(id);
        if (!target) return;
        event.preventDefault();
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Ecom guide banner",
  "class": "gg-banner-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "paragraph", "content": "Brand, tagline, and Choose gift are edited in the Header section." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "description", "label": "Desktop description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination.\nExplore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "textarea", "id": "description_mobile", "label": "Mobile description", "info": "Shown on screens 750px and smaller. If empty, the desktop description is used." },
    { "type": "text", "id": "shop_label", "label": "Shop now label", "default": "Shop now" },
    { "type": "text", "id": "shop_link", "label": "Shop now link", "default": "#ecom-guide-grid" },
    { "type": "text", "id": "strip_text", "label": "Bottom bar text", "default": "Sustainable, ethically made clothes in sizes XXS to 6XL" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "container",
      "info": "Container centers the banner in 1300px. Full width runs edge to edge. Mobile stays full width.",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "full", "label": "Full width" }
      ]
    },
    { "type": "header", "content": "Illustration" },
    { "type": "image_picker", "id": "illustration", "label": "Desktop image", "info": "Shown only on screens wider than 750px. Shopify's placeholder is used until an image is selected." },
    { "type": "image_picker", "id": "illustration_mobile", "label": "Mobile image", "info": "Shown only on screens 750px and smaller. Shopify's placeholder is used until an image is selected." },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "auto",
      "info": "Auto keeps the image's own ratio. Desktop and Portrait fill a frame and crop with cover.",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "desktop", "label": "Desktop" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    { "type": "header", "content": "Button animation" },
    {
      "type": "select",
      "id": "button_animation",
      "label": "Animation",
      "default": "fill",
      "options": [
        { "value": "fill", "label": "Fill sweep and arrow" },
        { "value": "arrow", "label": "Arrow slide" },
        { "value": "lift", "label": "Lift" },
        { "value": "none", "label": "None" }
      ]
    },
    { "type": "checkbox", "id": "enable_entrance", "label": "Animate text on load", "default": true },
    { "type": "checkbox", "id": "strip_marquee", "label": "Scroll the bottom bar", "default": false },
    { "type": "header", "content": "Color scheme" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "info": "Sets the background and text. Buttons and the bottom bar use the extra colors below." },
    { "type": "header", "content": "Extra colors" },
    { "type": "color", "id": "shop_background", "label": "Shop now background", "default": "#111111" },
    { "type": "color", "id": "shop_text", "label": "Shop now text", "default": "#FFFFFF" },
    { "type": "color", "id": "shop_hover_background", "label": "Shop now hover background", "default": "#FFFFFF" },
    { "type": "color", "id": "shop_hover_text", "label": "Shop now hover text", "default": "#111111" },
    { "type": "color", "id": "strip_background", "label": "Bottom bar background", "default": "#F3F3F3" },
    { "type": "color", "id": "strip_color", "label": "Bottom bar text", "default": "#1A1A1A" },
    { "type": "header", "content": "Desktop text position" },
    {
      "type": "paragraph",
      "content": "On desktop the text sits on top of the artwork. These controls move that block. Mobile keeps the title above the image."
    },
    {
      "type": "select",
      "id": "content_place_x",
      "label": "Horizontal position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "content_place_y",
      "label": "Vertical position",
      "min": 24,
      "max": 58,
      "step": 1,
      "unit": "%",
      "default": 54,
      "info": "0 is the top of the banner. Higher numbers move the text down."
    },
    {
      "type": "range",
      "id": "content_nudge_x",
      "label": "Horizontal nudge",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Pushes the text inward from the chosen side."
    },
    {
      "type": "range",
      "id": "content_nudge_y",
      "label": "Vertical nudge",
      "min": 0,
      "max": 16,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Moves the text down from the vertical position."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "header", "content": "Mobile text" },
    {
      "type": "paragraph",
      "content": "Mobile keeps the title above the image and the button on the artwork. These defaults match that layout."
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_button_place",
      "label": "Button position",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "mobile_button_bottom",
      "label": "Button distance from image bottom",
      "min": 56,
      "max": 104,
      "step": 4,
      "unit": "px",
      "default": 92
    },
    { "type": "range", "id": "mobile_gutter", "min": 16, "max": 32, "step": 2, "unit": "px", "label": "Side spacing", "default": 28 },
    { "type": "range", "id": "mobile_space_below", "min": 8, "max": 24, "step": 2, "unit": "px", "label": "Space under the text", "default": 16 },
    { "type": "range", "id": "mobile_heading_size", "min": 18, "max": 26, "step": 1, "unit": "px", "label": "Heading size", "default": 22 },
    { "type": "range", "id": "mobile_body_size", "min": 11, "max": 14, "step": 1, "unit": "px", "label": "Description size", "default": 12 },
    { "type": "header", "content": "Desktop type and spacing" },
    { "type": "range", "id": "heading_size", "min": 40, "max": 70, "step": 1, "unit": "px", "label": "Heading size", "default": 52 },
    { "type": "range", "id": "body_size", "min": 13, "max": 28, "step": 1, "unit": "px", "label": "Description size", "default": 15 },
    { "type": "range", "id": "shop_size", "min": 13, "max": 23, "step": 1, "unit": "px", "label": "Shop now size", "default": 13 },
    { "type": "range", "id": "strip_size", "min": 10, "max": 14, "step": 1, "unit": "px", "label": "Bottom bar size", "default": 12 },
    { "type": "range", "id": "content_width", "min": 320, "max": 720, "step": 10, "unit": "px", "label": "Text width", "default": 440 },
    { "type": "range", "id": "gutter", "min": 16, "max": 48, "step": 2, "unit": "px", "label": "Side spacing", "default": 40 }
  ],
  "presets": [
    { "name": "Ecom guide banner" }
  ]
}
{% endschema %}
