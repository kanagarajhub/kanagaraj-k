{{ 'section-gift-guide-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-guide-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign companion = section.settings.companion_product
  if companion == blank
    assign companion = all_products['soft-winter-jacket']
  endif

  assign companion_id = ''
  assign companion_title = section.settings.companion_title | default: 'Soft Winter Jacket' | strip
  if companion != blank and companion.id != blank
    assign companion_variant = companion.selected_or_first_available_variant
    if companion_variant != blank
      assign companion_id = companion_variant.id
    endif
    if companion.title != blank
      assign companion_title = companion.title
    endif
  endif

  assign overlay_alpha = section.settings.overlay_opacity | times: 1.0 | divided_by: 100.0
  case section.settings.image_ratio
    when 'square'
      assign card_ratio = '1 / 1'
    when 'portrait'
      assign card_ratio = '4 / 5'
    else
      assign card_ratio = '1 / 1.04'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --gg-bg: {{ section.settings.background }};
    --gg-text: {{ section.settings.heading_color }};
    --gg-heading-size: {{ section.settings.heading_size }}px;
    --gg-gap: {{ section.settings.gap }}px;
    --gg-columns: {{ section.settings.columns_desktop }};
    --gg-columns-mobile: {{ section.settings.columns_mobile }};
    --gg-radius: {{ section.settings.card_radius }}px;
    --gg-ratio: {{ card_ratio }};
    --gg-plus-bg: {{ section.settings.plus_background }};
    --gg-plus-color: {{ section.settings.plus_color }};
    --gg-accent: {{ section.settings.accent_color }};
    --gg-popup-bg: {{ section.settings.popup_background }};
    --gg-popup-text: {{ section.settings.popup_text }};
    --gg-overlay: {{ section.settings.overlay_color | color_modify: 'alpha', overlay_alpha }};
    --gg-gutter: {{ section.settings.gutter }}px;
    --gg-pad-top: {{ section.settings.padding_top }}px;
    --gg-pad-bottom: {{ section.settings.padding_bottom }}px;
    --gg-popup-width: {{ section.settings.popup_width }}px;
  }

  #shopify-section-{{ section.id }} .gg-btn {
    --gg-btn-bg: {{ section.settings.button_background }};
    --gg-btn-text: {{ section.settings.button_text }};
    --gg-btn-hover-bg: {{ section.settings.button_hover_background }};
    --gg-btn-hover-text: {{ section.settings.button_hover_text }};
  }
{%- endstyle -%}

<section
  id="gift-guide-grid"
  class="gg-grid{% if section.settings.heading_alignment == 'center' %} gg-grid--center{% endif %}{% if section.settings.enable_animation %} gg-grid--animate{% endif %}"
  data-gift-guide
  data-section-id="{{ section.id }}"
  data-animate="{% if section.settings.enable_animation %}true{% else %}false{% endif %}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  data-companion-id="{{ companion_id }}"
  data-companion-title="{{ companion_title | escape }}"
  data-trigger-a="{{ section.settings.trigger_a | escape }}"
  data-trigger-b="{{ section.settings.trigger_b | escape }}"
  data-label-add="{{ section.settings.add_label | escape }}"
  data-label-adding="{{ section.settings.adding_label | escape }}"
  data-label-soldout="{{ section.settings.sold_out_label | escape }}"
  data-label-choose="{{ section.settings.choose_prompt | escape }}"
  data-label-placeholder="{{ section.settings.placeholder_message | escape }}"
>
  <div class="gg-grid__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="gg-grid__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="gg-grid__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign card_image = block.settings.image
          if card_image == blank and product != blank and product.featured_image != blank
            assign card_image = product.featured_image
          endif
          assign placeholder_index = forloop.index | modulo: 6
          if placeholder_index == 0
            assign placeholder_index = 6
          endif
          assign card_title = product.title | default: 'product'
        -%}
        <li
          class="gg-card"
          style="--gg-delay: {{ forloop.index0 }}"
          data-demo-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="gg-card__frame" data-gg-visual>
            {%- if card_image != blank -%}
              <img
                src="{{ card_image | image_url: width: 900 }}"
                srcset="{{ card_image | image_url: width: 400 }} 400w, {{ card_image | image_url: width: 700 }} 700w, {{ card_image | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                alt="{{ card_image.alt | default: card_title | escape }}"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {% render 'gift-guide-placeholder', index: placeholder_index %}
            {%- endif -%}
          </div>

          <button
            type="button"
            class="gg-card__open"
            data-gg-open
            aria-haspopup="dialog"
            aria-label="View {{ card_title | escape }}"
          >
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
              <path d="M8 1.5v13M1.5 8h13" fill="none" stroke="currentColor" stroke-width="1.4"></path>
            </svg>
          </button>

          {%- if product != blank -%}
            <script type="application/json" data-gg-product>
              {
                "id": {{ product.id | json }},
                "title": {{ product.title | json }},
                "description": {{ product.description | strip_html | json }},
                "demo": false,
                "featuredImage": {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},
                "options": [
                  {%- for option in product.options_with_values -%}
                    {
                      "name": {{ option.name | json }},
                      "values": [
                        {%- for value in option.values -%}
                          {%- if value.name != blank -%}
                            {{ value.name | json }}
                          {%- else -%}
                            {{ value | json }}
                          {%- endif -%}
                          {%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                      ]
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ],
                "variants": [
                  {%- for variant in product.variants -%}
                    {
                      "id": {{ variant.id }},
                      "available": {{ variant.available | json }},
                      "price": {{ variant.price }},
                      "compareAtPrice": {% if variant.compare_at_price %}{{ variant.compare_at_price }}{% else %}null{% endif %},
                      "options": [
                        {{ variant.option1 | json }}
                        {%- if variant.option2 != blank -%}, {{ variant.option2 | json }}{%- endif -%}
                        {%- if variant.option3 != blank -%}, {{ variant.option3 | json }}{%- endif -%}
                      ],
                      "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 480 | json }}{% elsif card_image %}{{ card_image | image_url: width: 480 | json }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 480 | json }}{% else %}null{% endif %}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              }
            </script>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="gg-modal" data-gg-modal hidden>
    <div class="gg-modal__backdrop" data-gg-close></div>
    <div
      class="gg-modal__dialog"
      data-gg-dialog
      role="dialog"
      aria-modal="true"
      aria-labelledby="GiftGuideTitle-{{ section.id }}"
    >
      <button type="button" class="gg-modal__close" data-gg-close aria-label="{{ section.settings.close_label | escape }}">
        <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M1 1l12 12M13 1 1 13" fill="none" stroke="currentColor" stroke-width="1.4"></path>
        </svg>
      </button>
      <div class="gg-modal__layout">
        <div class="gg-modal__media" data-gg-media></div>
        <div class="gg-modal__info">
          <h3 class="gg-modal__title" id="GiftGuideTitle-{{ section.id }}" data-gg-title></h3>
          <p class="gg-modal__price" data-gg-price></p>
          <p class="gg-modal__description" data-gg-description></p>
          <div data-gg-options></div>
          <p class="gg-modal__message" data-gg-message hidden></p>
          <button type="button" class="gg-btn gg-btn--cart gg-btn--fill" data-gg-add>
            <span class="gg-btn__label" data-gg-add-label>{{ section.settings.add_label | escape }}</span>
            <svg class="gg-btn__icon" viewBox="0 0 20 12" width="18" height="10" aria-hidden="true" focusable="false">
              <path d="M0 6h17M12.5 1.5 18 6l-5.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift guide grid",
  "class": "gg-grid-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tisso vison in the wild" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#161616" },
    { "type": "range", "id": "heading_size", "min": 24, "max": 64, "step": 1, "unit": "px", "label": "Heading size", "default": 36 },
    { "type": "header", "content": "Grid" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "photo",
      "options": [
        { "value": "photo", "label": "Photo" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    { "type": "range", "id": "gap", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Gap", "default": 18 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 24, "step": 1, "unit": "px", "label": "Card corner radius", "default": 0 },
    { "type": "range", "id": "gutter", "min": 12, "max": 80, "step": 2, "unit": "px", "label": "Side spacing", "default": 40 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 },
    { "type": "checkbox", "id": "enable_animation", "label": "Animate cards into view", "default": true },
    { "type": "color", "id": "plus_background", "label": "Plus button background", "default": "#FFFFFF" },
    { "type": "color", "id": "plus_color", "label": "Plus button icon", "default": "#111111" },
    { "type": "header", "content": "Popup" },
    { "type": "range", "id": "popup_width", "min": 360, "max": 640, "step": 10, "unit": "px", "label": "Popup width", "default": 460 },
    { "type": "color", "id": "popup_background", "label": "Popup background", "default": "#FFFFFF" },
    { "type": "color", "id": "popup_text", "label": "Popup text", "default": "#161616" },
    { "type": "color", "id": "accent_color", "label": "Selected option accent", "default": "#2F6BFF" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#6E6E6E" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 1, "unit": "%", "label": "Overlay opacity", "default": 46 },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "adding_label", "label": "Adding label", "default": "Adding…" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "choose_prompt", "label": "Size prompt", "default": "Choose your size" },
    { "type": "text", "id": "close_label", "label": "Close label", "default": "Close" },
    { "type": "text", "id": "placeholder_message", "label": "Message when no product is selected", "default": "Select a product for this block in the theme editor to add it to the cart." },
    { "type": "color", "id": "button_background", "label": "Add to cart background", "default": "#111111" },
    { "type": "color", "id": "button_text", "label": "Add to cart text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_background", "label": "Add to cart hover background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_text", "label": "Add to cart hover text", "default": "#111111" },
    { "type": "header", "content": "Automatic extra product" },
    {
      "type": "paragraph",
      "content": "When the chosen variant includes both trigger values, the extra product is added to the cart too. Point this at Soft Winter Jacket."
    },
    { "type": "product", "id": "companion_product", "label": "Auto-add product" },
    { "type": "text", "id": "companion_title", "label": "Auto-add product title", "default": "Soft Winter Jacket", "info": "Used to find the product if the picker above is empty." },
    { "type": "text", "id": "trigger_a", "label": "First trigger value", "default": "Black" },
    { "type": "text", "id": "trigger_b", "label": "Second trigger value", "default": "Medium" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Optional. Replaces the product photo and the placeholder." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift guide grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
