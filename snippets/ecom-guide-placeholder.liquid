{% comment %}
  Photo stand-in for an ecom guide tile. Replaced when a product
  image or a custom block image is available.
  @param {number} index - 1-based position, chooses the palette
{% endcomment %}
<div class="gg-ph gg-ph--{{ index | default: 1 }}">
  {%- case index -%}
    {%- when 1 -%}
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <path d="M28 52h64l-6 40H34L28 52z" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path d="M40 52c0-14 8-24 20-24s20 10 20 24" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path d="M48 72h24M46 84h28" fill="none" stroke="currentColor" stroke-width="1.6"/>
      </svg>
    {%- when 2 -%}
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <circle cx="60" cy="46" r="16" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path d="M34 96c4-18 14-28 26-28s22 10 26 28" fill="none" stroke="currentColor" stroke-width="1.6"/>
      </svg>
    {%- when 3 -%}
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <path d="M36 48l24-16 24 16v40H36V48z" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path d="M48 88V64h24v24" fill="none" stroke="currentColor" stroke-width="1.6"/>
      </svg>
    {%- when 4 -%}
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <path d="M34 50l10-14h32l10 14v36H34V50z" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path d="M34 58h52M48 50v36M72 50v36" fill="none" stroke="currentColor" stroke-width="1.6"/>
      </svg>
    {%- when 5 -%}
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <path d="M32 46h56v42H32z" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path d="M32 58h56M52 46v42" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="60" cy="40" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/>
      </svg>
    {%- else -%}
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <circle cx="46" cy="58" r="14" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="74" cy="58" r="14" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path d="M60 58h2M28 54c-6 2-8 8-6 12M92 54c6 2 8 8 6 12" fill="none" stroke="currentColor" stroke-width="1.6"/>
      </svg>
  {%- endcase -%}
</div>
