{% doc %}
  Button arrow. Uses the built-in icon, a pasted SVG, or an uploaded image.

  @param {string} [source] - `default`, `svg`, or `image`
  @param {string} [svg] - SVG markup when source is `svg`
  @param {image} [image] - Image when source is `image`

  @example
  {% render 'ecom-guide-arrow', source: section.settings.arrow_source, svg: section.settings.arrow_svg, image: section.settings.arrow_image %}
{% enddoc %}

{%- liquid
  assign icon_source = source | default: 'default'
  assign svg_markup = svg
  assign svg_ok = false
  if icon_source == 'svg' and svg_markup != blank
    assign svg_check = svg_markup | downcase
    if svg_check contains '<svg'
      unless svg_check contains '<script' or svg_check contains 'javascript:'
        assign svg_ok = true
      endunless
    endif
  endif
-%}
<span class="gg-btn__icon">
  {%- if icon_source == 'image' and image != blank -%}
    <img
      src="{{ image | image_url: width: 80 }}"
      alt=""
      width="18"
      height="18"
      loading="lazy"
    >
  {%- elsif svg_ok -%}
    {{ svg_markup }}
  {%- else -%}
    <svg viewBox="0 0 20 12" width="18" height="10" aria-hidden="true" focusable="false">
      <path d="M0 6h17M12.5 1.5 18 6l-5.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4"></path>
    </svg>
  {%- endif -%}
</span>
